<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="CourseHub administrator overview of accounts, courses, and enrollments.">
    <title>CourseHub | Admin dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./components/header') %>
    <main class="dashboard-shell">
        <section class="dashboard-heading">
            <div>
                <p class="eyebrow">Administration</p>
                <h1>CourseHub overview</h1>
                <p>Review accounts, course activity, and enrollments from one place.</p>
            </div>
            <a class="enroll-button dashboard-action" href="/manage/courses/new">Add a course <span aria-hidden="true">+</span></a>
        </section>

        <% if (notice) { %>
            <div class="notice <%= notice.type %>" role="status"><%= notice.message %></div>
        <% } %>

        <section class="dashboard-stats" aria-label="Platform totals">
            <article class="dashboard-stat"><span>Accounts</span><strong><%= accounts.length %></strong></article>
            <article class="dashboard-stat"><span>Courses</span><strong><%= courses.length %></strong></article>
            <article class="dashboard-stat"><span>Published courses</span><strong><%= courses.filter((course) => course.isActive).length %></strong></article>
            <article class="dashboard-stat"><span>Enrollments</span><strong><%= enrollments.length %></strong></article>
        </section>

        <section class="dashboard-panel" aria-labelledby="admin-courses-title">
            <div class="dashboard-panel-heading">
                <div><p class="eyebrow">Catalog</p><h2 id="admin-courses-title">All courses</h2></div>
            </div>
            <% if (courses.length === 0) { %>
                <p class="dashboard-empty">There are no courses in the catalog.</p>
            <% } else { %>
                <div class="dashboard-table-wrap">
                    <table class="dashboard-table">
                        <thead><tr><th>Course</th><th>Instructor</th><th>Enrolled</th><th>Status</th><th>Actions</th></tr></thead>
                        <tbody>
                            <% courses.forEach((course) => { %>
                                <tr>
                                    <td><%- include('./components/course-photo', { course, photoClass: 'course-photo-dashboard' }) %><strong><%= course.title %></strong><span class="table-secondary"><%= course.category %></span></td>
                                    <td><%= course.instructor %></td>
                                    <td><%= course.enrollmentCount %> / <%= course.capacity %></td>
                                    <td><span class="status-badge <%= course.isActive ? 'status-published' : 'status-archived' %>"><%= course.isActive ? 'Published' : 'Archived' %></span></td>
                                    <td>
                                        <div class="dashboard-row-actions">
                                            <a href="/manage/courses/<%= course._id %>/edit">Edit</a>
                                            <form action="/manage/courses/<%= course._id %>/status" method="POST">
                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                <input type="hidden" name="isActive" value="<%= course.isActive ? 'false' : 'true' %>">
                                                <button type="submit"><%= course.isActive ? 'Archive' : 'Publish' %></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <section class="dashboard-panel" aria-labelledby="admin-accounts-title">
            <div class="dashboard-panel-heading">
                <div><p class="eyebrow">People</p><h2 id="admin-accounts-title">All accounts</h2></div>
                <span><%= accounts.length %> total</span>
            </div>
            <% if (accounts.length === 0) { %>
                <p class="dashboard-empty">There are no accounts yet.</p>
            <% } else { %>
                <div class="dashboard-table-wrap">
                    <table class="dashboard-table">
                        <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead>
                        <tbody>
                            <% accounts.forEach((account) => { %>
                                <tr>
                                    <td><strong><%= account.name %></strong></td>
                                    <td><%= account.email %></td>
                                    <td><span class="status-badge"><%= account.role %></span></td>
                                    <td><%= account.createdAt.toLocaleDateString() %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>

        <section class="dashboard-panel" aria-labelledby="admin-enrollments-title">
            <div class="dashboard-panel-heading">
                <div><p class="eyebrow">Learning activity</p><h2 id="admin-enrollments-title">All enrollments</h2></div>
                <span><%= enrollments.length %> total</span>
            </div>
            <% if (enrollments.length === 0) { %>
                <p class="dashboard-empty">There are no enrollments yet.</p>
            <% } else { %>
                <div class="dashboard-table-wrap">
                    <table class="dashboard-table">
                        <thead><tr><th>Student</th><th>Email</th><th>Course</th><th>Enrolled</th></tr></thead>
                        <tbody>
                            <% enrollments.forEach((enrollment) => { %>
                                <tr>
                                    <td><strong><%= enrollment.studentAccount ? enrollment.studentAccount.name : enrollment.studentName %></strong></td>
                                    <td><%= enrollment.studentAccount ? enrollment.studentAccount.email : enrollment.studentEmail %></td>
                                    <td>
                                        <% if (enrollment.course) { %>
                                            <%- include('./components/course-photo', { course: enrollment.course, photoClass: 'course-photo-dashboard' }) %>
                                            <%= enrollment.course.title %>
                                        <% } else { %>
                                            Course unavailable
                                        <% } %>
                                    </td>
                                    <td><%= enrollment.enrolledAt.toLocaleDateString() %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
    <%- include('./components/footer') %>
</body>
</html>
