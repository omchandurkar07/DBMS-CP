<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= course.description %>">
    <title>CourseHub | <%= course.title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./components/header') %>
    <main>
        <div class="breadcrumb"><a href="/courses">Courses</a><span aria-hidden="true">/</span><span><%= course.title %></span></div>
        <% if (notice) { %>
            <div class="notice <%= notice.type %>" role="status"><%= notice.message %></div>
        <% } %>
        <section class="detail-layout">
            <article class="course-detail-card">
                <%- include('./components/course-photo', { course, photoClass: 'course-photo-detail' }) %>
                <div class="course-card-top">
                    <span class="course-category"><%= course.category %></span>
                </div>
                <h1><%= course.title %></h1>
                <p class="detail-description"><%= course.description %></p>
                <div class="detail-facts">
                    <div><span>Instructor</span><strong><%= course.instructor %></strong></div>
                    <div><span>Duration</span><strong><%= course.duration %></strong></div>
                    <div><span>Students enrolled</span><strong><%= course.enrollmentCount %> / <%= course.capacity %></strong></div>
                    <div><span>Availability</span><strong><%= Math.max(course.capacity - course.enrollmentCount, 0) %> places remaining</strong></div>
                </div>
                <section class="course-curriculum" aria-labelledby="course-curriculum-title">
                    <div class="curriculum-heading">
                        <div>
                            <p class="eyebrow">Inside the course</p>
                            <h2 id="course-curriculum-title">Curriculum</h2>
                        </div>
                        <% if (learningEnrollment && learningEnrollment.lessonCount > 0) { %>
                            <span><%= learningEnrollment.completedLessonCount %> of <%= learningEnrollment.lessonCount %> lessons · <%= learningEnrollment.progress %>%</span>
                        <% } %>
                    </div>
                    <% if (course.modules && course.modules.length > 0) { %>
                        <ol class="course-module-list">
                            <% course.modules.forEach((module, moduleIndex) => { %>
                                <li class="course-module">
                                    <h3><span>Module <%= moduleIndex + 1 %></span><%= module.title %></h3>
                                    <ol class="course-lesson-list">
                                        <% module.lessons.forEach((lesson) => { %>
                                            <li>
                                                <% if (learningEnrollment) { %>
                                                    <a href="/learn/<%= course._id %>/<%= lesson._id %>">
                                                        <span><%= lesson.title %></span>
                                                        <span><%= lesson.durationMinutes %> min <span aria-hidden="true">→</span></span>
                                                    </a>
                                                <% } else { %>
                                                    <span><%= lesson.title %></span>
                                                    <span><%= lesson.durationMinutes %> min</span>
                                                <% } %>
                                                <% if (lesson.summary) { %>
                                                    <p><%= lesson.summary %></p>
                                                <% } %>
                                                <% const lessonId = lesson._id ? lesson._id.toString() : ''; %>
                                                <% const lessonMaterials = lessonId ? (materialsByLesson[lessonId] || []) : []; %>
                                                <% if (lessonMaterials.length > 0) { %>
                                                    <ul class="learning-material-list" aria-label="Learning materials for <%= lesson.title %>">
                                                        <% lessonMaterials.forEach((material) => { %>
                                                            <li>
                                                                <a href="/courses/<%= course._id %>/materials/<%= material._id %>">
                                                                    <span aria-hidden="true">↓</span> <%= material.fileName %>
                                                                </a>
                                                                <span><%= (material.size / 1024).toFixed(0) %> KB</span>
                                                                <% if (canManageCourse) { %>
                                                                    <form action="/manage/courses/<%= course._id %>/materials/<%= material._id %>/delete" method="POST">
                                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                                        <button class="material-remove-button" type="submit">Remove</button>
                                                                    </form>
                                                                <% } %>
                                                            </li>
                                                        <% }); %>
                                                    </ul>
                                                <% } %>
                                                <% if (canManageCourse) { %>
                                                    <form class="material-upload-form" action="/manage/courses/<%= course._id %>/lessons/<%= lesson._id %>/materials" method="POST" enctype="multipart/form-data">
                                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                        <label>
                                                            <span>Add lesson material (PDF, DOCX, PPTX, XLSX, TXT, CSV; up to 10 MB; 20 per lesson, 50 per course)</span>
                                                            <input type="file" name="material" accept=".pdf,.docx,.pptx,.xlsx,.txt,.csv" required>
                                                        </label>
                                                        <button class="material-upload-button" type="submit">Upload material</button>
                                                    </form>
                                                <% } %>
                                            </li>
                                        <% }); %>
                                    </ol>
                                </li>
                            <% }); %>
                        </ol>
                    <% } else { %>
                        <p class="curriculum-empty">The instructor has not added lessons to this course yet.</p>
                    <% } %>
                </section>
                <% if (learningEnrollment || canManageCourse) { %>
                    <section class="course-community-section" id="course-announcements" aria-labelledby="course-announcements-title">
                        <div class="course-community-heading">
                            <div>
                                <p class="eyebrow">Class updates</p>
                                <h2 id="course-announcements-title">Course announcements</h2>
                            </div>
                        </div>
                        <% if (canManageCourse) { %>
                            <form class="course-community-form" action="/manage/courses/<%= course._id %>/announcements" method="POST">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <label for="announcement-title">Announcement title</label>
                                <input id="announcement-title" name="title" type="text" maxlength="120" required>
                                <label for="announcement-message">Message for enrolled students</label>
                                <textarea id="announcement-message" name="message" rows="4" maxlength="2000" required></textarea>
                                <button class="enroll-button" type="submit">Post announcement</button>
                            </form>
                        <% } %>
                        <% if (announcements.length > 0) { %>
                            <div class="course-community-list">
                                <% announcements.forEach((announcement) => { %>
                                    <article class="course-community-item">
                                        <div class="course-community-meta">
                                            <strong><%= announcement.title %></strong>
                                            <time datetime="<%= announcement.createdAt.toISOString() %>"><%= announcement.createdAt.toLocaleDateString() %></time>
                                        </div>
                                        <p><%= announcement.message %></p>
                                        <span>Posted by <%= announcement.authorName %></span>
                                    </article>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="course-community-empty">No announcements have been posted for this course yet.</p>
                        <% } %>
                    </section>
                <% } %>
                <section class="course-community-section" id="course-reviews" aria-labelledby="course-reviews-title">
                    <div class="course-community-heading">
                        <div>
                            <p class="eyebrow">Learner feedback</p>
                            <h2 id="course-reviews-title">Course reviews</h2>
                        </div>
                        <% if (reviewStats.count > 0) { %>
                            <p class="course-review-summary"><strong><%= reviewStats.averageRating.toFixed(1) %> / 5</strong> · <%= reviewStats.count %> reviews</p>
                        <% } else { %>
                            <p class="course-review-summary">No reviews yet</p>
                        <% } %>
                    </div>
                    <% if (canReview) { %>
                        <form class="course-community-form" action="/courses/<%= course._id %>/reviews" method="POST">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <label for="review-rating">Your rating</label>
                            <select id="review-rating" name="rating" required>
                                <option value="" <%= existingReview ? '' : 'selected' %> disabled>Choose a rating</option>
                                <% [5, 4, 3, 2, 1].forEach((rating) => { %>
                                    <option value="<%= rating %>" <%= existingReview && existingReview.rating === rating ? 'selected' : '' %>><%= rating %> / 5</option>
                                <% }); %>
                            </select>
                            <label for="review-comment">Review (optional)</label>
                            <textarea id="review-comment" name="comment" rows="4" maxlength="1000"><%= existingReview ? existingReview.comment : '' %></textarea>
                            <button class="enroll-button" type="submit"><%= existingReview ? 'Update your review' : 'Submit review' %></button>
                        </form>
                    <% } else if (!currentUser) { %>
                        <p class="course-community-empty"><a href="/login?next=<%= encodeURIComponent(`/courses/${course._id}`) %>">Sign in and enroll</a> to review this course.</p>
                    <% } else if (currentUser.role === 'student') { %>
                        <p class="course-community-empty">Enroll in this course to leave a review.</p>
                    <% } else { %>
                        <p class="course-community-empty">Course reviews are available to enrolled students.</p>
                    <% } %>
                    <% if (reviews.length > 0) { %>
                        <div class="course-community-list">
                            <% reviews.forEach((review) => { %>
                                <article class="course-community-item">
                                    <div class="course-community-meta">
                                        <strong><%= review.authorName %></strong>
                                        <span><%= review.rating %> / 5</span>
                                    </div>
                                    <time datetime="<%= (review.updatedAt || review.createdAt).toISOString() %>"><%= (review.updatedAt || review.createdAt).toLocaleDateString() %></time>
                                    <% if (review.comment) { %>
                                        <p><%= review.comment %></p>
                                    <% } %>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <p class="course-community-empty">Be the first enrolled student to review this course.</p>
                    <% } %>
                </section>
            </article>
            <aside class="enroll-panel">
                <p class="eyebrow">Join this course</p>
                <h2>Ready to enroll?</h2>
                <% if (learningEnrollment) { %>
                    <p>You are enrolled and have completed <strong><%= learningEnrollment.progress %>%</strong> of this course.</p>
                <% } else if (currentUser && currentUser.role === 'student') { %>
                    <p>Enroll as <strong><%= currentUser.name %></strong> (<%= currentUser.email %>).</p>
                <% } else if (!currentUser) { %>
                    <p class="enroll-panel-copy">Join the class in a few steps. Sign in to continue, or create a free student account.</p>
                <% } else { %>
                    <p>Course enrollment is available to student accounts.</p>
                <% } %>
                <% if (learningEnrollment && learningEnrollment.lessonCount > 0) { %>
                    <a class="enroll-button auth-enroll-link" href="<%= learningEnrollment.continueUrl %>">
                        <span><%= learningEnrollment.progress === 100 ? 'Review course' : 'Continue learning' %></span>
                        <span aria-hidden="true">→</span>
                    </a>
                <% } else if (learningEnrollment) { %>
                    <button class="enroll-button" type="button" disabled>Lessons coming soon</button>
                <% } else if (course.enrollmentCount >= course.capacity) { %>
                    <button class="enroll-button" type="button" disabled>Course is full</button>
                <% } else if (!currentUser) { %>
                    <div class="enroll-auth-actions">
                        <a class="enroll-button auth-enroll-link" href="/login?next=<%= encodeURIComponent(`/courses/${course._id}`) %>">
                            <span>Sign in to enroll</span><span aria-hidden="true">→</span>
                        </a>
                        <p class="enroll-signup-prompt">
                            New to CourseHub?
                            <a href="/signup?next=<%= encodeURIComponent(`/courses/${course._id}`) %>">Create a student account</a>
                        </p>
                    </div>
                <% } else if (currentUser.role === 'student') { %>
                    <form class="enroll-form" action="/enroll" method="POST">
                        <input type="hidden" name="courseId" value="<%= course._id %>">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="enroll-button" type="submit">Enroll now <span aria-hidden="true">→</span></button>
                    </form>
                <% } %>
                <a class="back-link" href="/courses">← Back to all courses</a>
            </aside>
        </section>
    </main>
    <%- include('./components/footer') %>
</body>
</html>
