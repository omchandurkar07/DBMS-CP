<header class="site-header">
    <a class="brand" href="/" aria-label="CourseHub home">
        <span class="brand-mark" aria-hidden="true">
            <svg class="brand-logo" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 11.5C12.8 10.2 17.1 11.1 20 13.4V30C17.1 27.7 12.8 26.8 8 28.1V11.5Z" fill="currentColor" fill-opacity=".22" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M32 11.5C27.2 10.2 22.9 11.1 20 13.4V30C22.9 27.7 27.2 26.8 32 28.1V11.5Z" fill="currentColor" fill-opacity=".12" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M12 16.5C14.1 16.2 16 16.6 17.5 17.5M12 20.5C14.1 20.2 16 20.6 17.5 21.5M28 16.5C25.9 16.2 24 16.6 22.5 17.5M28 20.5C25.9 20.2 24 20.6 22.5 21.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M30.5 7.5V11.5M28.5 9.5H32.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
        </span>
        <span>CourseHub</span>
    </a>
    <nav class="main-nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/courses">Browse courses</a>
        <% if (currentUser) { %>
            <% if (currentUser.role === 'admin') { %>
                <a href="/admin">Admin</a>
            <% } else if (currentUser.role === 'teacher') { %>
                <a href="/teacher">Teaching</a>
            <% } else { %>
                <a href="/my-learning">My learning</a>
            <% } %>
            <a href="/profile">Profile</a>
            <span class="nav-greeting">Hi, <%= currentUser.name %></span>
            <form class="nav-auth-form" action="/logout" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="nav-auth-button" type="submit">Sign out</button>
            </form>
        <% } else { %>
            <a href="/teacher/login">Teach on CourseHub</a>
            <a class="nav-signin" href="/login">Sign in</a>
            <a class="nav-signup" href="/signup">Create account</a>
        <% } %>
    </nav>
</header>
