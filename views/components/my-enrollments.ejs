<section class="content-section learning-section" id="my-enrollments" aria-labelledby="learning-title">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Student dashboard</p>
            <h2 id="learning-title">Welcome, <%= studentName %></h2>
            <p class="section-copy">Your enrolled courses are gathered here for <%= studentEmail %>.</p>
        </div>
    </div>
    <div class="enrollment-results">
        <h3>Your enrolled courses</h3>
        <% if (enrollments.length === 0) { %>
            <div class="empty-state">
                <h3>No enrollments yet</h3>
                <p>Browse the catalog and enroll in a course to see it here.</p>
                <a class="course-link dashboard-browse-link" href="/courses">Browse courses <span aria-hidden="true">→</span></a>
            </div>
        <% } else { %>
            <div class="enrollment-list">
                <% enrollments.forEach((enrollment) => { %>
                    <article class="enrollment-row">
                        <% if (enrollment.course) { %>
                            <%- include('./course-photo', { course: enrollment.course, photoClass: 'course-photo-enrollment' }) %>
                        <% } %>
                        <span class="enrolled-check" aria-hidden="true">✓</span>
                        <div class="enrollment-course">
                            <% if (enrollment.course) { %>
                                <h4><%= enrollment.course.title %></h4>
                                <p><%= enrollment.course.category %> · <%= enrollment.course.instructor %></p>
                            <% } else { %>
                                <h4>Course unavailable</h4>
                                <p>This course is no longer in the catalog.</p>
                            <% } %>
                        </div>
                        <% if (enrollment.course) { %>
                            <div class="enrollment-progress">
                                <div class="progress-label"><span>Progress</span><strong><%= enrollment.progress %>%</strong></div>
                                <progress class="course-progress" value="<%= enrollment.progress %>" max="100"
                                    aria-label="<%= enrollment.progress %>% complete in <%= enrollment.course.title %>"><%= enrollment.progress %>%</progress>
                                <a href="<%= enrollment.continueUrl %>"><%= enrollment.progress === 100 ? 'Review course' : enrollment.lessonCount ? 'Continue learning' : 'View course' %> →</a>
                            </div>
                        <% } %>
                        <time datetime="<%= enrollment.enrolledAt.toISOString() %>">
                            Enrolled <%= enrollment.enrolledAt.toLocaleDateString() %>
                        </time>
                    </article>
                <% }); %>
            </div>
        <% } %>
    </div>
</section>
