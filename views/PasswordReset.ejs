<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <meta name="description" content="Choose a new password for your CourseHub account.">
    <title>CourseHub | Reset password</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./components/header') %>
    <main class="auth-page">
        <section class="auth-card" aria-labelledby="reset-password-title">
            <p class="eyebrow">Account recovery</p>
            <h1 id="reset-password-title">Set a new password</h1>
            <% if (error) { %>
                <p class="auth-error" role="alert"><%= error %></p>
            <% } %>

            <% if (resetToken) { %>
                <p class="auth-intro">Choose a new password for your account. This reset link can only be used once.</p>
                <form class="auth-form" action="/reset-password" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="resetToken" value="<%= resetToken %>">
                    <label for="reset-password">New password</label>
                    <div class="password-control">
                        <input id="reset-password" type="password" name="password"
                            autocomplete="new-password" minlength="8" maxlength="128" required>
                        <button class="password-visibility" type="button" data-password-visibility
                            aria-label="Show password" aria-pressed="false">Show</button>
                    </div>
                    <p class="password-hint">Use between 8 and 128 characters.</p>
                    <button class="enroll-button" type="submit">Update password <span aria-hidden="true">→</span></button>
                </form>
            <% } else { %>
                <p class="auth-intro">Request a new password reset link to continue.</p>
                <a class="enroll-button reset-request-link" href="/forgot-password">Request a new link <span aria-hidden="true">→</span></a>
            <% } %>
            <p class="auth-switch"><a href="/login">Back to sign in</a></p>
        </section>
    </main>
    <%- include('./components/footer') %>
    <script src="/app.js" defer></script>
</body>
</html>
