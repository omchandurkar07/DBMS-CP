<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="no-referrer">
    <meta name="description" content="Request a secure CourseHub password reset link.">
    <title>CourseHub | Forgot password</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./components/header') %>
    <main class="auth-page">
        <section class="auth-card" aria-labelledby="reset-request-title">
            <p class="eyebrow">Account recovery</p>
            <h1 id="reset-request-title">Forgot your password?</h1>
            <p class="auth-intro">Enter the email address for your account. If it matches, we will email you a secure link to reset your password.</p>

            <% if (notice) { %>
                <p class="notice <%= notice.type %>" role="status"><%= notice.message %></p>
            <% } %>
            <% if (error) { %>
                <p class="auth-error" role="alert"><%= error %></p>
            <% } %>

            <form class="auth-form" action="/forgot-password" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label for="reset-request-email">Account email</label>
                <input id="reset-request-email" type="email" name="email" autocomplete="email" maxlength="254" required>
                <button class="enroll-button" type="submit">Send reset link <span aria-hidden="true">→</span></button>
            </form>
            <p class="auth-switch"><a href="/login">Back to sign in</a></p>
        </section>
    </main>
    <%- include('./components/footer') %>
</body>
</html>
