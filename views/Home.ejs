<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Discover courses and organize your student learning.">
    <title>CourseHub | Home</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <%- include('./components/header') %>

    <main>
        <%- include('./components/hero') %>

        <section class="home-stats" aria-label="CourseHub catalog highlights">
            <div><strong><%= courseCount %></strong><span>courses to explore</span></div>
            <span class="stats-divider" aria-hidden="true"></span>
            <div><strong><%= categoryCount %></strong><span>subject areas</span></div>
            <span class="stats-divider" aria-hidden="true"></span>
            <div><strong>One place</strong><span>to keep learning on track</span></div>
        </section>

        <%- include('./components/about') %>

        <section class="content-section featured-section" aria-labelledby="featured-title">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">A good place to begin</p>
                    <h2 id="featured-title">Popular courses</h2>
                    <p class="section-copy">Explore learner favorites, then find the course that fits your next goal.</p>
                </div>
                <a class="text-link" href="/courses">View all courses <span aria-hidden="true">→</span></a>
            </div>

            <% if (featuredCourses.length === 0) { %>
                <div class="empty-state">
                    <h3>New courses are on the way</h3>
                    <p>Check back soon to discover courses in the catalog.</p>
                </div>
            <% } else { %>
                <div class="course-grid featured-grid">
                    <% featuredCourses.forEach((course, index) => { %>
                        <article class="course-card featured-card">
                            <%- include('./components/course-photo', { course }) %>
                            <div class="course-card-top">
                                <span class="course-category"><%= course.category %></span>
                            </div>
                            <h3><%= course.title %></h3>
                            <p class="course-description"><%= course.description %></p>
                            <div class="course-meta">
                                <span>Duration</span><strong><%= course.duration %></strong>
                            </div>
                            <a class="course-link" href="/courses/<%= course._id %>">
                                Explore course <span aria-hidden="true">→</span>
                            </a>
                        </article>
                    <% }); %>
                </div>
            <% } %>
        </section>

        <section class="home-discover" aria-labelledby="discover-title">
            <div class="discover-copy">
                <p class="eyebrow">Curiosity starts somewhere</p>
                <h2 id="discover-title">What would you like to learn?</h2>
                <p>Browse subjects and find a <span class="underlined-keyword" data-underline-word>course<svg
                    class="hand-drawn-underline" viewBox="0 0 100 16" preserveAspectRatio="none"
                    aria-hidden="true" focusable="false"><path d="M3 11 C 20 5, 34 14, 51 8 S 79 5, 97 7"></path></svg></span>
                    that sparks your curiosity and gives your next skill somewhere to start.</p>
            </div>
            <div class="category-chips" aria-label="Popular course categories">
                <% categories.slice(0, 8).forEach((category) => { %>
                    <a class="category-chip" href="/courses?category=<%= encodeURIComponent(category) %>">
                        <%= category %><span aria-hidden="true">↗</span>
                    </a>
                <% }); %>
                <a class="category-chip category-chip-all" href="/courses">Explore every subject <span aria-hidden="true">→</span></a>
            </div>
        </section>

        <section class="home-benefits" aria-labelledby="benefits-title">
            <div class="benefits-intro">
                <p class="eyebrow">Learning, made simpler</p>
                <h2 id="benefits-title">A little structure goes a long way.</h2>
                <p>Spend less time figuring out where to start and more time learning something useful.</p>
            </div>
            <div class="benefit-list">
                <article class="benefit-item">
                    <span class="benefit-number">01</span>
                    <div><h3>Choose with confidence</h3><p>Compare topics, instructors, durations, and available places before enrolling.</p></div>
                </article>
                <article class="benefit-item">
                    <span class="benefit-number">02</span>
                    <div><h3>Make it your own</h3><p>Save interesting courses and come back to your shortlist whenever you like.</p></div>
                </article>
                <article class="benefit-item">
                    <span class="benefit-number">03</span>
                    <div><h3>Keep your progress close</h3><p>Look up your enrollments in My learning using your student email.</p></div>
                </article>
            </div>
        </section>

        <section class="home-cta">
            <div>
                <p class="eyebrow">Your next chapter starts here</p>
                <h2>Ready to find your next favorite subject?</h2>
                <p>Take a look around. A new skill could be one course away.</p>
            </div>
            <a class="button-link" href="/courses">Find your course <span aria-hidden="true">→</span></a>
        </section>
    </main>

    <%- include('./components/footer') %>
    <script src="/app.js" defer></script>
</body>
</html>
